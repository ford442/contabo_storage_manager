# Models directory — WebLLM-compatible serving on storage.1ink.us (DreamHost Apache)
# Brotli if mod_brotli is available, gzip fallback for JSON/text.
#
# DreamHost panel injects a weak Cache-Control / Expires — unset those first so
# our immutable headers win for model shards.

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS application/json application/javascript text/plain
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json application/javascript text/plain
</IfModule>

# Vary so caches know to store compressed and uncompressed separately
Header append Vary Accept-Encoding

# Clear host-panel defaults that otherwise override FilesMatch below
Header unset Cache-Control
Header always unset Cache-Control
Header unset Expires
Header always unset Expires

# Range requests — required for WebLLM resumable / parallel downloads
Header unset Accept-Ranges
Header always unset Accept-Ranges
Header always set Accept-Ranges "bytes"

# CORS — unset panel/parent copies first (onsuccess + always tables).
# Without this, browsers see Access-Control-Allow-Origin: *, *
Header unset Access-Control-Allow-Origin
Header always unset Access-Control-Allow-Origin
Header always set Access-Control-Allow-Origin "*"

Header unset Access-Control-Allow-Methods
Header always unset Access-Control-Allow-Methods
Header always set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"

Header unset Access-Control-Allow-Headers
Header always unset Access-Control-Allow-Headers
Header always set Access-Control-Allow-Headers "Range, Accept-Ranges, Content-Range, Cache-Control"

Header unset Access-Control-Expose-Headers
Header always unset Access-Control-Expose-Headers
Header always set Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges"

# Cache — model weights are immutable once uploaded
<FilesMatch "\.(bin|wasm|safetensors|onnx|mlmodel|gguf)$">
    Header unset Cache-Control
    Header always unset Cache-Control
    Header unset Expires
    Header always unset Expires
    Header always set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# JSON configs change rarely (tokenizer / mlc-chat-config)
<FilesMatch "\.json$">
    Header unset Cache-Control
    Header always unset Cache-Control
    Header unset Expires
    Header always unset Expires
    Header always set Cache-Control "public, max-age=86400"
</FilesMatch>

# Pre-compressed model shards (.bin.gz, .wasm.gz) — serve raw bytes, not Content-Encoding: gzip
<FilesMatch "\.gz$">
    RemoveEncoding .gz
    AddType application/octet-stream .gz
    Header always set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Preflight
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^ - [R=204,L]
</IfModule>
